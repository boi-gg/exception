{
  "name": "exception-kind",
  "version": "0.0.3",
  "license": "MIT",
  "private": false,
  "description": "A library to handle exceptions in a structured way.",
  "repository": {
    "url": "https://github.com/tnfssc/exception"
  },
  "readme": "https://github.com/tnfssc/exception/blob/develop/README.md",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "lint": "eslint ./src",
    "ci": "tsc --noEmit && eslint ./src && vitest run --coverage && prettier --check . && tsdown"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.36.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "prettier": "^3.6.2",
    "tsdown": "^0.14.2",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
